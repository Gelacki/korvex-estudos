{
  "name": "kovex-estudos",
  "productName": "Kovex Estudos",
  "version": "1.1.0",
  "description": "Gerador de exercícios de programação e lógica, do iniciante ao avançado, com apostilas em PDF",
  "main": "main.js",
  "author": "Kovex",
  "license": "UNLICENSED",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "testar": "node scripts/testar-geradores.js",
    "icone": "node scripts/gerar-icone.js",
    "apostilas": "electron . --gerar-apostilas ../apostilas",
    "dist": "npm run testar && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.kovex.estudos",
    "productName": "Kovex Estudos",
    "copyright": "Kovex",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kovex Estudos",
      "artifactName": "Kovex-Estudos-Setup-${version}.${ext}",
      "language": "1046"
    }
  }
}
